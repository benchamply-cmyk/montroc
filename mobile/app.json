{
  "expo": {
    "name": "TopTroc",
    "slug": "troctroc",
    "scheme": "troctroc",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111318",
    "ios": {
      "bundleIdentifier": "fr.troctroc.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.troctroc.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "TopTroc a besoin de vos photos pour montrer les objets que vous proposez.",
          "cameraPermission": "TopTroc a besoin de l'appareil photo pour photographier les objets que vous proposez."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "api": "https://api.toptroc.com"
    }
  }
}
