{
  "expo": {
    "name": "TopTroc",
    "slug": "toptroc",
    "scheme": "toptroc",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111318",
    "ios": {
      "bundleIdentifier": "com.toptroc.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.toptroc.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "TopTroc a besoin de vos photos pour montrer les objets que vous proposez.",
          "cameraPermission": "TopTroc a besoin de l'appareil photo pour photographier les objets que vous proposez.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "api": "https://api.toptroc.com",
      "router": {},
      "eas": {
        "projectId": "2292364d-6040-469d-9bb3-937356e9e816"
      }
    },
    "owner": "bentester"
  }
}
