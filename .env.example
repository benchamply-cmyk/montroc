# Copier ce fichier en api/.env (jamais committé) et adapter.
# Base locale lancée par `docker compose up -d` :
DATABASE_URL=postgresql+psycopg://montroc:montroc@localhost:5432/montroc
# Base de test (vidée par les tests) :
TEST_DATABASE_URL=postgresql+psycopg://montroc:montroc@localhost:5432/montroc_test
# Origines autorisées à appeler l'API depuis un navigateur :
CORS_ORIGINS=http://localhost:8000,https://troctroc.fr,https://www.troctroc.fr
ENVIRONNEMENT=local
