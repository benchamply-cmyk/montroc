# Copier ce fichier en api/.env (jamais committé) et adapter.
# Base locale lancée par `docker compose up -d` :
DATABASE_URL=postgresql+psycopg://montroc:montroc@localhost:5432/montroc
# Base de test (vidée par les tests) :
TEST_DATABASE_URL=postgresql+psycopg://montroc:montroc@localhost:5432/montroc_test
# Origines autorisées à appeler l'API depuis un navigateur :
CORS_ORIGINS=http://localhost:8000,https://troctroc.fr,https://www.troctroc.fr
ENVIRONNEMENT=local
SITE_URL=http://localhost:8000
# E-mails : sans mot de passe, ils sont écrits dans la console de l'API (pratique pour récupérer
# le lien de connexion en local). En production : ssl0.ovh.net, port 465, une adresse @troctroc.fr.
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Photos : cloudinary://clé:secret@nom-du-cloud (tableau de bord Cloudinary > API Keys).
CLOUDINARY_URL=
# E-mails des modérateurs, séparés par des virgules :
MODERATEURS=
# Secret des tâches planifiées (/taches/…) :
TACHES_SECRET=
POINT_DE_DEPOT=
